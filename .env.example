# Synthetic local development only; these match scripts/db.sh.
DATABASE_URL=postgresql+psycopg://pap:pap_local_only@127.0.0.1:55432/pap
# Read-only MySolArk source connection; independent of PAP storage.
SOURCE_DATABASE_DSN=dbname=pubnub_development host=/tmp
# Fixed from the user-approved observed minimum; approximately their 30% SOC reserve.
# DW 1.24 override; other wings use fixed scanned floors in selection.py.
BATTERY_FLOOR_V=305.2
# Local models already installed on this Mac; tests use their own deterministic double.
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text:latest

# Optional third role; ordinary runs without ambiguity remain model-free.
ENABLE_INTERPRETATION_AGENT=false
AGENT_MODEL=gemma3:4b
AGENT_BACKEND=ollama
# Switch BOTH backend and model, then restart the service.
# OpenAI: AGENT_BACKEND=openai, AGENT_MODEL=gpt-4.1-mini
# Claude: AGENT_BACKEND=anthropic, AGENT_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=configure-locally-only
# ANTHROPIC_API_KEY=configure-locally-only
# Only agent calls switch; embeddings remain local Ollama.
RETRIEVAL_MIN_SCORE=0.3

# Demonstration escalation policy: re-tune from recent measured outcomes, then restart.
# These change interpretation/confidence only; T5/T6 voltage and power checks stay fixed.
CALIBRATION_BIAS_LIMIT_KW=0.25
CALIBRATION_DRIFT_LIMIT_KW=0.25
CALIBRATION_WINDOW_SAMPLES=20
# Review interval also bounds the age of eligible live outcome feedback.
CALIBRATION_REVIEW_DAYS=7
# Set only after reviewing the thresholds; leaving unset shows Review due.
# CALIBRATION_REVIEWED_AT=2026-09-07T18:00:00-07:00

# development reads MySolArk; macmini-replay/test default to the sunny fixture.
PAP_PROFILE=development
# Summary-only export, off by default. SDK auto tracing stays disabled.
ENABLE_LANGSMITH=false
# LANGSMITH_API_KEY=configure-locally-only
# LANGSMITH_PROJECT=pap-development
